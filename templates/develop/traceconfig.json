{
  "_comment": "利用プロジェクト直下に traceconfig.json として置く（orchestrator が人間の承認を得て書く。値はスタックの rules-* の common-traceconfig が差分を示す）。tools/trace-check / spec-lint / contract-run / gate-hook が読む。キーの意味と検査項目は tools/trace-check/README.md。紐づきの宣言（docs.actors / vision / glossary / shared、source、tests、tests.system、schema、contract とその子）は省略できない。対象が無いなら { \"none\": \"<理由>\" } と書く。none と範囲の一致 0 件が通るのは、それを求める active な文書・fixed な契約が無い間だけ（C26）。baseline と、コードに書く例外の印は無い（ADR-0056）。dirs 系はパスか glob の配列で、\"!\" で始まるものは除外。注釈はコメントの中だけを数える（comment_pattern）。正規表現は u フラグでコンパイルする。",
  "id_patterns": {
    "goal": "\\bGOAL-\\d{2}\\b",
    "uc": "\\bUC-\\d{3}\\b",
    "req": "\\bREQ-\\d{3}\\b",
    "br": "\\bBR-\\d{3}\\b",
    "nfr": "\\bNFR-\\d{3}\\b",
    "adr": "\\bADR-\\d{4}\\b"
  },
  "covers_pattern": "@covers\\s+(REQ-\\d{3})(?!\\d)(?:#([\\w-]+))?",
  "scenario_pattern": "@scenario\\s+(UC-\\d{3})(?!\\d)",
  "nfr_pattern": "@covers\\s+(NFR-\\d{3})(?!\\d)",
  "operation_pattern": "@operation\\s+(UC-\\d{3})#(\\w+)",
  "implements_pattern": "@implements\\s+((?:REQ|BR|UC)-\\d{3}(?!\\d)(?:\\s*[,、/]\\s*(?:REQ|BR|UC)-\\d{3}(?!\\d))*)",
  "docs": {
    "goals_dir": "docs/goals",
    "goals_backlog": "docs/goals-backlog.md",
    "rules_dir": "docs/rules",
    "nfr_dir": "docs/nfr",
    "adr_dir": "docs/adr",
    "verification_global": "docs/verification/GLOBAL.md",
    "verification_deferred": "docs/verification/DEFERRED.md",
    "shared": "docs/_shared/components.yaml",
    "actors": "docs/02-actors.md",
    "vision": "docs/00-vision.md",
    "glossary": "docs/01-glossary.md"
  },
  "commands": {
    "_comment": "tools/gate-hook/stop-gate.mjs（最終ゲート）と tools/contract-run が読み、trace-check は読まない（cwd = 利用プロジェクト直下）。typecheck / lint / test / system はシェル 1 行か { \"none\": \"<理由>\" } で必ず宣言する（欠落は失敗。tests を宣言していれば test は none にできない）。stop-gate は typecheck -> lint -> test -> system の順に実行する。system はシナリオスイート全体を 1 回実行するコマンドで、終了ごとに走らせるには遅すぎるなら理由付きの none にする（CI では実行する）。contract_adapter は契約の実例を実行するプロセス（JSONL。stdin 1 行 1 リクエスト / stdout 1 行 1 応答）。test-author が書いてから宣言する。fixed 契約の owned の操作があるのに未宣言なら contract-run が失敗にする（ADR-0056）。",
    "typecheck": "npx tsc --noEmit",
    "lint": "npx eslint .",
    "test": "npm test --silent",
    "system": "npx playwright test"
  },
  "policy": {
    "_comment": "組織とプロジェクトで変わる方針の値（ADR-0050）。develop-core と rules-* はここをキー名で読み、未宣言なら記した既定値を使う。方法論そのもの（人間ゲート、作成者 ≠ 判定者、成果物の型）はここに置かない。language は会話と成果物（docs、契約の説明文、ADR、コミットメッセージ、コード内コメント、テストのタイトル、利用者向けの文言）の言語で、BCP 47 の言語タグ。未宣言なら ja。harness 自身のプロンプト正本の言語（ADR-0043）とは別。",
    "language": "ja"
  },
  "git": {
    "_comment": "tools/git-lint が読む（ブランチ名とコミットメッセージのヘッダー。再利用 CI workflow が全 pull request で実行）。spec-lint gate も units を読み、コミットの UC: trailer を scope の単位の docs で探す。このブロックを削除すれば両方を未検査にする。git-lint は未検査と報告し、成功としては扱わない。この例のブランチは <type>/<topic>。モノレポでは独立デプロイするアプリや共有パッケージごとに名前とディレクトリを対応付ける units を追加する。例: \"units\": { \"app-a\": \"apps/a\", \"ui\": \"packages/ui\" }。その場合のブランチは <unit>/<topic>（単位に属さない変更は repo/<topic>）で、コミット scope は単位か repo が必須。orchestrator はここから単位を読み、配置から推測してはならない。exempt_branches は bot 用の未検査ブランチの glob（** / * / ?）一覧。",
    "exempt_branches": [
      "dependabot/**"
    ]
  },
  "source": {
    "dirs": [
      "src",
      "!**/*.test.*",
      "!**/*.spec.*"
    ],
    "extensions": [
      ".ts",
      ".tsx"
    ],
    "unit_dirs": [
      "src/usecase/**"
    ],
    "support_dirs": [
      "src/index.*",
      "src/*.d.ts",
      "src/domain/**",
      "src/infra/**",
      "src/shared/**"
    ],
    "unit_pattern": "^export\\s+(?:default\\s+)?(?:async\\s+)?function\\*?\\s*(\\w*)\\s*[<(]|^export\\s+(?:default\\s+)?(?:abstract\\s+)?class\\s+(\\w+)|^export\\s+(?:const|let)\\s+(\\w+)\\s*(?::[^=]+)?=\\s*(?:async\\s*)?(?:<[^>]*>\\s*)?(?:\\(|function\\b|\\w+\\s*=>|\\w+\\s*\\(\\s*(?:async\\s*)?(?:\\(|function\\b|\\w+\\s*=>))|^export\\s+default\\s+(?:(\\w+)\\s*;?\\s*$|(?:async\\s*)?(?:\\(|\\w+\\s*\\())|^export\\s*\\{(?!(?:\\s*type\\s+\\w+(?:\\s+as\\s+\\w+)?\\s*,?)*\\s*\\})\\s*([^}]*?)\\s*(?:\\}\\s*;?\\s*)?$",
    "implements_placement": "before",
    "entry_pattern": "\\.(?:get|post|put|patch|delete|all)\\(\\s*[\"'`](\\/[^\"'`]*)|\\.route\\(\\s*[\"'`](\\/[^\"'`]*)|\\.on\\(\\s*(?:[\"'`][A-Z]+[\"'`]|\\[[^\\]]*\\])\\s*,\\s*[\"'`](\\/[^\"'`]*)"
  },
  "tests": {
    "dirs": [
      "tests"
    ],
    "extensions": [
      ".ts",
      ".tsx"
    ],
    "test_pattern": "^\\s*x?(?:it|test)(?:\\.(?:skip|only|fixme|todo|concurrent|each\\(.*?\\)|for\\(.*?\\)))*\\(\\s*[\"'`](.+?)[\"'`]|^\\s*x?(?:it|test)(?:\\.\\w+)*\\.(?:each|for)[(`]\\s*\\[?\\s*$|^\\s*x?(?:it|test)(?:\\.(?:skip|only|fixme|todo|concurrent))*\\(\\s*$",
    "pending_pattern": "^\\s*(?:it|test|describe)(?:\\.describe)?\\.(?:skip|fixme|todo|skipIf|runIf)\\b|^\\s*x(?:it|test|describe)\\(|^\\s*x?(?:it|test)(?:\\.\\w+)*\\(\\s*[\"'`].*?[\"'`]\\s*,\\s*\\{[^}]*\\b(?:skip|todo):\\s*true",
    "covers_placement": "before",
    "system": {
      "dirs": [
        "e2e"
      ],
      "extensions": [
        ".ts"
      ],
      "test_pattern": "^\\s*x?(?:it|test)(?:\\.(?:skip|only|fixme|todo|concurrent|each\\(.*?\\)|for\\(.*?\\)))*\\(\\s*[\"'`](.+?)[\"'`]|^\\s*x?(?:it|test)(?:\\.\\w+)*\\.(?:each|for)[(`]\\s*\\[?\\s*$|^\\s*x?(?:it|test)(?:\\.(?:skip|only|fixme|todo|concurrent))*\\(\\s*$",
      "pending_pattern": "^\\s*(?:it|test|describe)(?:\\.describe)?\\.(?:skip|fixme|todo|skipIf|runIf)\\b|^\\s*x(?:it|test|describe)\\(|^\\s*x?(?:it|test)(?:\\.\\w+)*\\(\\s*[\"'`].*?[\"'`]\\s*,\\s*\\{[^}]*\\b(?:skip|todo):\\s*true",
      "scenario_placement": "before"
    }
  },
  "schema": {
    "files": [
      "prisma/schema.prisma"
    ],
    "constraint_pattern": "^\\s*(\\w+)\\s+\\S+(?:(?!\\/\\/).)*@unique\\b|^\\s*@@unique\\(\\s*(?:fields:\\s*)?\\[([^\\]]+)\\]"
  },
  "layering": {
    "root": "src",
    "layer_pattern": "{layer}",
    "forbidden": {
      "domain": [
        "usecase",
        "infra"
      ],
      "usecase": [
        "infra"
      ]
    },
    "import_patterns": [
      "^\\s*import\\s.*from\\s+['\"][^'\"]*/{layer}(/|['\"])"
    ]
  },
  "contract": {
    "error_source": "src/domain/errors.ts",
    "error_code_pattern": "\\bcode\\s*[:=]\\s*['\"]([A-Z][A-Z0-9_]*)['\"]"
  }
}
