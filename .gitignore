*~

# ログ・一時ファイル
*.log

# Cursor 射影（生成物。取り込み先/検証用に ./init.sh cursor で再生成する）
.cursor/

# Grok Build 射影（生成物。./init.sh grok で再生成する。config.toml 等は対象外）
.grok/agents/

# Codex 射影（生成物。./init.sh codex で再生成する。ホストの .codex/config.toml は対象外）
.agents/
.codex/agents/

# trace-check の採番予約とロック（一時状態。番号は使われた時点で台帳から落ちる）
.trace-reservations.json
.trace-next.lock

# gate-hook / stop-gate の拒否ログと状態（一時。ゲート降格判断のデータ）
.harness-gate/

# 全ベンダー向け prompt は packages/ からの生成物
.claude/
.agents/
.codex/
.cursor/
.grok/
.harness-legacy.json
